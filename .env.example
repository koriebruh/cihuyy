# ─── Server ───────────────────────────────────────────────────────────────────
# Port the HTTP server listens on (REST API, WebSocket, /metrics)
ME_SERVER_PORT=8080

# Maximum duration to read the full request, including body
ME_SERVER_READTIMEOUT=30s

# Maximum duration before the response is timed out
ME_SERVER_WRITETIMEOUT=30s

# Graceful shutdown window: in-flight requests are drained for this long
ME_SERVER_SHUTDOWNTIMEOUT=10s

# ─── Engine ───────────────────────────────────────────────────────────────────
# Capacity of the internal event channel (book.updated, trade.created, etc.)
# Increase this if the consumer (WebSocket fan-out) is slower than the engine.
ME_ENGINE_EVENTBUFFERSIZE=10000

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis server address (host:port)
ME_REDIS_ADDR=localhost:6379

# Redis AUTH password (leave empty if authentication is not configured)
ME_REDIS_PASSWORD=

# Redis database number (0–15)
ME_REDIS_DB=0

# Enable the Redis integration (order/trade persistence, pub-sub fan-out)
ME_REDIS_ENABLED=false

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error
ME_LOG_LEVEL=info

# Emit logs as JSON (true) or human-readable console format (false)
ME_LOG_JSON=false
